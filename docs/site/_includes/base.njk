{%- set t = strings[lang] -%}
{%- set root = page.url | root -%}
{%- set other = lang | otherLang -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if slug %}{{ title }} · kadr{% else %}kadr · {{ t.headline }}{% endif %}</title>
<meta name="description" content="{{ t.description }}">
<link rel="icon" type="image/svg+xml" href="{{ root }}assets/kadr.svg">
<link rel="stylesheet" href="{{ root }}assets/site.css">
<link rel="alternate" hreflang="{{ other }}" href="{{ root }}{{ other | pageUrl(slug) }}">
</head>
<body>
<header class="top">
  <a class="wordmark" href="{{ root }}{{ lang | pageUrl('') }}">kadr</a>
  <nav>
    <a href="https://github.com/evlaso/kadr">{{ t.github }}</a>
    <a href="{{ root }}{{ other | pageUrl(slug) }}" lang="{{ other }}">{{ t.other }}</a>
  </nav>
</header>
{{ content | safe }}
</body>
</html>
