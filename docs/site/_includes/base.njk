{%- set t = strings[lang] -%}
{%- set root = page.url | root -%}
{%- set other = lang | otherLang -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != "kadr" %}{{ title }} · kadr{% else %}kadr{% endif %}</title>
<meta name="description" content="{{ description or 'Screenshots and screen recording for Linux, macOS and Windows. Native, written in Rust.' }}">
<link rel="icon" type="image/svg+xml" href="{{ root }}assets/kadr.svg">
<link rel="stylesheet" href="{{ root }}assets/site.css">
<link rel="alternate" hreflang="{{ other }}" href="{{ root }}{{ otherUrl }}">
</head>
<body>
<header class="top">
  <a class="wordmark" href="{{ root }}{% if lang != 'en' %}{{ lang }}/{% endif %}">kadr</a>
  <nav>
    <a href="{{ root }}{{ (lang | manualBase).slice(1) }}"{% if slug !== undefined %} aria-current="true"{% endif %}>{{ t.manual }}</a>
    <a href="https://github.com/evlaso/kadr">{{ t.github }}</a>
    <a href="{{ root }}{{ otherUrl }}" lang="{{ other }}">{{ t.other }}</a>
  </nav>
</header>
{{ content | safe }}
</body>
</html>
