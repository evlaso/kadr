---
layout: base.njk
---
{%- set t = strings -%}
{%- set root = page.url | root -%}
{%- set pages = nav -%}
<div class="manual">
  <aside class="menu">
    <div class="menu-inner">
    <div class="menu-head">
      <a class="wordmark" href="{{ root }}">kadr</a>
      <button class="find" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span>{{ t.search }}</span><kbd>Ctrl K</kbd>
      </button>
      <a class="out" href="https://github.com/evlaso/kadr">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
        <span>{{ t.github }}</span>
      </a>
    </div>
    <details class="menu-fold" open>
      <summary>{{ t.pages }}</summary>
      {%- for group in [pages, projectNav] %}
      <ul class="pages{% if loop.index0 %} project-pages{% endif %}">
        {%- for p in group %}
        <li>
          <a href="{{ root }}{{ p.slug | pageUrl }}"{% if p.slug == slug %} aria-current="page"{% endif %}>{{ p.title if p.slug else t.intro }}</a>
          {%- if p.slug == slug %}
          {%- set outline = content | outline %}
          {%- if outline.length %}
          <ul class="outline">
            {%- for h in outline %}
            <li><a href="#{{ h.id }}">{{ h.title }}</a></li>
            {%- endfor %}
          </ul>
          {%- endif %}
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
      {%- endfor %}
    </details>
    </div>
  </aside>
  <main class="prose" data-pagefind-body>
    {%- if slug %}
    <h1>{{ title }}</h1>
    {{ content | withoutTitle | safe }}
    {%- else %}
    <h1 data-pagefind-meta="title:kadr">{{ t.headline }}</h1>
    <div class="lead">{{ content | withoutTitle | firstParagraph | safe }}</div>
    <p class="get" id="get" data-latest="{{ root }}releases/latest.json" data-all="{{ t.allReleases }}" data-pagefind-ignore>
      <a class="button" href="https://github.com/evlaso/kadr/releases">{{ t.download }}</a>
      <span class="note">{{ t.downloadNote }}</span>
    </p>
    <div class="home-shot">{{ "editor-light.webp" | manualImage(t.shotAlt, root, false) | safe }}</div>
    {{ content | withoutTitle | afterFirstParagraph | safe }}
    {%- endif %}
    {%- if not sourceFile %}
    <footer class="turn">
      {%- for p in pages %}{% if p.slug == slug %}
      {%- set prev = pages[loop.index0 - 1] if loop.index0 > 0 %}
      {%- set next = pages[loop.index0 + 1] %}
      <span>{% if prev %}<a href="{{ root }}{{ prev.slug | pageUrl }}">← {{ prev.title if prev.slug else t.intro }}</a>{% endif %}</span>
      <span>{% if next %}<a href="{{ root }}{{ next.slug | pageUrl }}">{{ next.title }} →</a>{% endif %}</span>
      {%- endif %}{% endfor %}
    </footer>
    {%- endif %}
    <div class="edit" data-pagefind-ignore><span><a href="https://github.com/evlaso/kadr/edit/main/{% if sourceFile %}{{ sourceFile }}{% else %}docs/manual/{{ slug or 'README' }}.md{% endif %}">{{ t.edit }}</a> · <a href="{{ root }}{{ slug | mdUrl }}">{{ t.asMarkdown }}</a> · <a href="{{ root }}llms-full.txt" title="{{ t.llmsTip }}">{{ t.llms }}</a></span> <span class="theme" role="group" aria-label="{{ t.theme }}"><button type="button" data-theme-is="system">{{ t.system }}</button><button type="button" data-theme-is="light">{{ t.light }}</button><button type="button" data-theme-is="dark">{{ t.dark }}</button></span></div>
  </main>
</div>
