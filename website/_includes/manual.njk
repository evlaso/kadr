---
layout: base.njk
---
{%- set t = strings[lang] -%}
{%- set root = page.url | root -%}
{%- set pages = nav[lang] -%}
<div class="manual">
  <aside class="menu">
    <div class="menu-inner">
    <div class="menu-head">
      <a class="wordmark" href="{{ root }}{{ lang | pageUrl('') }}">kadr</a>
      <button class="find" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" hidden>
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span>{{ t.search }}</span><kbd>Ctrl K</kbd>
      </button>
      <a class="out" href="https://github.com/evlaso/kadr">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
        <span>{{ t.github }}</span>
      </a>
    </div>
    <details class="menu-fold" open>
      <summary>{{ t.pages }}</summary>
      <ul class="pages">
        {%- for p in pages %}
        <li>
          <a href="{{ root }}{{ lang | pageUrl(p.slug) }}"{% if p.slug == slug %} aria-current="page"{% endif %}>{{ p.title if p.slug else t.intro }}</a>
          {%- if p.slug == slug %}
          {%- set outline = content | outline %}
          {%- if outline.length %}
          <ul class="outline">
            {%- for h in outline %}
            <li><a href="#{{ h.id }}">{{ h.title }}</a></li>
            {%- endfor %}
          </ul>
          {%- endif %}
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </details>
    </div>
  </aside>
  <main class="prose" data-pagefind-body>
    {%- if slug %}
    <h1>{{ title }}</h1>
    {{ content | withoutTitle | safe }}
    {%- else %}
    <h1 data-pagefind-meta="title:kadr">{{ t.headline }}</h1>
    <div class="lead">{{ content | withoutTitle | firstParagraph | safe }}</div>
    <p class="get" id="get" data-latest="{{ root }}releases/latest.json" data-all="{{ t.allReleases }}" data-pagefind-ignore>
      <a class="button" href="https://github.com/evlaso/kadr/releases">{{ t.download }}</a>
      <span class="note">{{ t.downloadNote }}</span>
    </p>
    <img class="shot" src="{{ root }}images/editor.png" alt="{{ t.shotAlt }}" width="1401" height="777">
    {{ content | withoutTitle | afterFirstParagraph | safe }}
    {%- endif %}
    <footer class="turn">
      {%- for p in pages %}{% if p.slug == slug %}
      {%- set prev = pages[loop.index0 - 1] if loop.index0 > 0 %}
      {%- set next = pages[loop.index0 + 1] %}
      <span>{% if prev %}<a href="{{ root }}{{ lang | pageUrl(prev.slug) }}">← {{ prev.title if prev.slug else t.intro }}</a>{% endif %}</span>
      <span>{% if next %}<a href="{{ root }}{{ lang | pageUrl(next.slug) }}">{{ next.title }} →</a>{% endif %}</span>
      {%- endif %}{% endfor %}
    </footer>
    <p class="edit" data-pagefind-ignore><a href="https://github.com/evlaso/kadr/edit/main/docs/manual/{{ lang }}/{{ slug or 'README' }}.md">{{ t.edit }}</a> · <a href="{{ root }}{{ lang | mdUrl(slug) }}">{{ t.asMarkdown }}</a></p>
  </main>
</div>
