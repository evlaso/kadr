{%- set t = strings[lang] -%}
{%- set root = page.url | root -%}
{%- set other = lang | otherLang -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if slug %}{{ title }} · kadr{% else %}kadr · {{ t.headline }}{% endif %}</title>
<meta name="description" content="{{ t.description }}">
<link rel="icon" type="image/svg+xml" href="{{ root }}assets/kadr.svg">
<link rel="stylesheet" href="{{ root }}assets/site.css">
<link rel="alternate" hreflang="{{ other }}" href="{{ root }}{{ other | pageUrl(slug) }}">
</head>
<body>
<header class="top">
  <a class="wordmark" href="{{ root }}{{ lang | pageUrl('') }}">kadr</a>
  <nav>
    <button class="find" type="button" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" hidden>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <span>{{ t.search }}</span><kbd>Ctrl K</kbd>
    </button>
    <a href="https://github.com/evlaso/kadr">{{ t.github }}</a>
    <a href="{{ root }}{{ other | pageUrl(slug) }}" lang="{{ other }}">{{ t.other }}</a>
  </nav>
</header>
{{ content | safe }}
<dialog class="palette" aria-label="{{ t.search }}" data-index="{{ root }}{{ lang | pageUrl('') }}search.json" data-base="{{ root }}{{ lang | pageUrl('') }}" data-pagefind="{{ root }}pagefind/pagefind.js">
  <div class="palette-field">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
    <input type="text" role="combobox" aria-expanded="true" aria-autocomplete="list" aria-controls="palette-list" aria-label="{{ t.search }}" placeholder="{{ t.find }}" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go">
  </div>
  <ul class="palette-list" id="palette-list" role="listbox" aria-label="{{ t.results }}"></ul>
  <p class="palette-none" role="status" hidden>{{ t.nothing }}</p>
</dialog>
<script src="{{ root }}assets/site.js" defer></script>
</body>
</html>
